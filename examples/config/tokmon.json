{
  "schema": "org.tokmon.desktop.config/v1",
  "data_root": ".tokmon/data",
  "model": "gpt-5",
  "snow": {
    "mode": "process",
    "raw_trace": false,
    "request_timeout_ms": 300000,
    "restart": {
      "enabled": true,
      "max_attempts": 5,
      "base_delay_ms": 250
    }
  },
  "ui": {
    "poll_interval_ms": 25,
    "scale": 1.25
  }
}
