@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG)
find_dependency(unofficial-sqlite3 CONFIG)
find_dependency(CURL CONFIG)
if(NOT WIN32 AND NOT APPLE)
  find_dependency(OpenSSL)
endif()
if(@TOKMON_CONFIG_WITH_GUI@)
  find_dependency(SDL3 CONFIG)
  find_dependency(lexbor CONFIG)
  find_dependency(yoga CONFIG)
  find_dependency(unofficial-skia CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TokmonTargets.cmake")
check_required_components(Tokmon)
